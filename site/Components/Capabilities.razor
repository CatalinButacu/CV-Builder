@* Home page: the kinds of work I do as a grid of unequal tiles, each backed by a project. *@
<section id="capabilities" class="section">
    <div class="container-x">
        <div class="section-head centred">
            <div>
                <p class="section-eyebrow">What I build</p>
                <h2 class="section-title">Five kinds of work, each with code to show for it.</h2>
            </div>
        </div>

        <ul class="bento">
            @for (var i = 0; i < Data.Capabilities.All.Length; i++)
            {
                <CapabilityTile Capability="Data.Capabilities.All[i]" Number="i + 1" Lead="i == 0" />
            }
            <CertificationsTile />
            <Toolbox />
        </ul>
    </div>
</section>
