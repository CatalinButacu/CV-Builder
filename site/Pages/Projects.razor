@page "/projects"

<Section Eyebrow="Work" Title="Projects" PageHeading="true"
         Subtitle="@($"Generative AI, computer vision, security and optimisation work — {ProjectCatalog.All.Length} entries, each with public source code.")">
    <ul class="project-grid">
        @foreach (var project in ProjectCatalog.All)
        {
            <li><ProjectCard Project="project" /></li>
        }
    </ul>
</Section>
