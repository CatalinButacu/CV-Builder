@page "/projects/{Slug}"

@if (Project is null)
{
    <Section Eyebrow="404" Title="Project not found" PageHeading="true"
             Subtitle="There is no project at this address.">
        <a class="btn secondary" href="projects/">← All projects</a>
    </Section>
}
else
{
    <article class="container-x detail">
        <a class="back" href="projects/">← All projects</a>

        <header class="detail-head">
            <ProjectCover Project="Project" />

            <div class="detail-copy">
                <div class="badges">
                    <Badge Variant="accent">@Project.Kind</Badge>
                    @if (Project.InProgress)
                    {
                        <Badge Variant="warning" Dot="true">In progress</Badge>
                    }
                </div>
                <h1>@Project.Title</h1>
                <p class="lede">@Project.Summary</p>
                <p class="meta">
                    <span>@Project.Year</span>
                    <a href="@Project.Repo" target="_blank" rel="noopener">GitHub ↗</a>
                </p>
            </div>
        </header>

        <div class="detail-body">
            <div class="prose">
                @if (Detail is not null)
                {
                    <p>@Detail.Intro</p>
                    @foreach (var section in Detail.Sections)
                    {
                        <h2>@section.Heading</h2>
                        <ul>
                            @foreach (var point in section.Points)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }
                }
            </div>

            <aside class="surface">
                <h2 class="mono-label">Tech stack</h2>
                <ul class="chips">
                    @foreach (var item in Project.Stack)
                    {
                        <li class="chip">@item</li>
                    }
                </ul>
                <a class="btn primary" href="@Project.Repo" target="_blank" rel="noopener">View source on GitHub ↗</a>
            </aside>
        </div>
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Project? Project => ProjectCatalog.Find(Slug);
    private ProjectDetail? Detail => ProjectDetails.For(Slug);
}
