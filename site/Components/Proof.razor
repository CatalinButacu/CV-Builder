@* The evidence, as four figures. Each term comes first for screen readers and is shown under its figure. *@
<dl class="proof">
    @foreach (var fact in Facts)
    {
        <div>
            <dt>@fact.Label</dt>
            <dd>@fact.Figure<small>@fact.Unit</small></dd>
        </div>
    }
</dl>

@code {
    private sealed record Fact(string Figure, string Unit, string Label);

    private static readonly Fact[] Facts =
    [
        new("4", "yrs", "of C++/Qt in production"),
        new(ProjectCatalog.All.Length.ToString(), "", "ML projects with public code"),
        new(Profile.VerifiableCertifications.ToString(), "", "verifiable certifications"),
        new("8", "th", "nationally, WiDS Datathon 2025"),
    ];
}
