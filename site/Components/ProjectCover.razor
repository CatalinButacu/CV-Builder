@* The top of a project card: the project's result as a large figure with a few words under it. *@
<p class="cover">
    <span class="figure">@Project.Figure</span>
    <span class="caption">@Project.FigureLabel</span>
</p>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
}
