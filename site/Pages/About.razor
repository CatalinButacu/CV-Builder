@page "/about"

<Section Eyebrow="About" Title="@Profile.Person.Name" PageHeading="true" Subtitle="@Profile.Person.Summary" />

<Section Id="experience" Eyebrow="01 / Experience" Title="Professional experience">
    <div class="stack">
        @foreach (var job in Profile.Experience)
        {
            <OrganisationCard Organisation="job" />
        }
    </div>
</Section>

<Section Id="skills" Eyebrow="02 / Skills" Title="Tech stack">
    <SkillsPanel />
</Section>

<Section Id="education" Eyebrow="03 / Education" Title="Education">
    <div class="stack">
        @foreach (var degree in Profile.Education)
        {
            <DegreeCard Degree="degree" />
        }
    </div>
</Section>

<Section Id="certifications" Eyebrow="04 / Certifications" Title="Certifications">
    <CertificationList />
</Section>

<Section Id="volunteering" Eyebrow="05 / Volunteering" Title="Volunteer experience">
    <OrganisationCard Organisation="Profile.Volunteering" />
</Section>
