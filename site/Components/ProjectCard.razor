@* A project tile: its result first, then badges, summary, a few stack chips and the year. *@
<a class="project-card surface gradient-border" href="projects/@(Project.Slug)/">
    <ProjectCover Project="Project" />

    <div class="body">
        <ProjectBadges Project="Project" />

        <h3>@Project.Title</h3>
        <p class="summary">@Project.Summary</p>

        <ul class="chips" aria-label="Tech stack">
            @foreach (var item in Project.Stack.Take(MaxChips))
            {
                <li class="chip">@item</li>
            }
            @if (Project.Stack.Length > MaxChips)
            {
                <li class="chip more">+@(Project.Stack.Length - MaxChips) more</li>
            }
        </ul>

        <div class="foot">
            <span>@Project.Year</span>
            <span>Details →</span>
        </div>
    </div>
</a>

@code {
    private const int MaxChips = 3;

    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
}
