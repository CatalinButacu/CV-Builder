@* Header control for colour mode and palette. The markup is static; js/theme.js
   opens the panel, applies the choice and remembers it. *@
<div class="theme-menu">
    <button type="button" class="theme-button" aria-label="Theme settings" aria-expanded="false" aria-controls="theme-panel">
        <span aria-hidden="true">◐</span>
    </button>

    <div class="theme-panel surface" id="theme-panel" hidden>
        <p class="mono-label" id="theme-mode-label">Mode</p>
        <div class="segmented" role="radiogroup" aria-labelledby="theme-mode-label">
            @foreach (var mode in Modes)
            {
                <button type="button" role="radio" aria-checked="false" data-mode="@mode">@mode</button>
            }
        </div>

        <p class="mono-label" id="theme-palette-label">Palette</p>
        <div class="swatches" role="radiogroup" aria-labelledby="theme-palette-label">
            @foreach (var palette in Site.Palettes)
            {
                // data-palette also gives the swatch that palette's own two colours.
                <button type="button" role="radio" class="swatch" aria-checked="false" data-palette="@palette" data-pick="@palette"
                        title="@palette.Replace('-', ' ')" aria-label="@palette.Replace('-', ' ')"></button>
            }
        </div>
        <div class="segmented">
            <button type="button" aria-pressed="false" data-pick="rotate">Change on every refresh</button>
        </div>
    </div>
</div>

@code {
    private static readonly string[] Modes = ["system", "light", "dark"];
}
