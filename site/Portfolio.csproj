<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A build-time generator: `dotnet run` renders the Razor pages to static HTML.
       Nothing from .NET is shipped to the browser. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
