@* Home page: every job as one row with its dates, employer and a single result line. *@
<section id="experience" class="section">
    <div class="container-x split">
        <div class="split-head">
            <p class="section-eyebrow">Experience</p>
            <h2 class="section-title">Software that runs in production, every day.</h2>
            <p class="section-subtitle">
                Machine learning work is only useful once it is shipped and maintained. This is where I learned to do that.
            </p>
            <a class="text-link" href="about/">Full background and education</a>
        </div>

        <ol class="xp">
            @foreach (var organisation in Profile.Experience)
            {
                @foreach (var role in organisation.Roles)
                {
                    <li>
                        <p class="when">@role.Period</p>
                        <div>
                            <h3>@role.Title</h3>
                            <p class="org">@organisation.Name · @organisation.Location</p>
                            <p class="result">@(role.Highlight ?? role.Bullets[0])</p>
                        </div>
                    </li>
                }
            }
        </ol>
    </div>
</section>
