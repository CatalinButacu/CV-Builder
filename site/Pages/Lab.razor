@page "/lab"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Lab · Cătălin Butacu</PageTitle>

<Section Eyebrow="Lab" Title="A nano-GPT, learning to sort" PageHeading="true"
         Subtitle="A small GPT is given six letters and has to write them back in order. This is a replay of its real training run: the weights change in front of you and its answers go from wrong to right.">

    <div class="lab surface" @ref="panel">
        <canvas class="lab-canvas" @ref="canvas" role="img"
                aria-label="Animated diagram of the model: its weight matrices and intermediate results as blocks, stepped through from input to output."></canvas>

        <div class="lab-progress" aria-hidden="true"><span data-gpt="bar"></span></div>

        <dl class="lab-stats">
            <div>
                <dt data-gpt="state">Training</dt>
                <dd data-gpt="step">–</dd>
            </div>
            <div>
                <dt>Loss</dt>
                <dd data-gpt="loss">–</dd>
            </div>
            <div>
                <dt>Sorted correctly</dt>
                <dd data-gpt="accuracy">–</dd>
            </div>
            <div class="example">
                <dt>This example</dt>
                <dd>
                    <span data-gpt="question">–</span>
                    <span aria-hidden="true">→</span>
                    <span data-gpt="answer">–</span>
                    <span class="verdict" data-gpt="verdict"></span>
                </dd>
            </div>
        </dl>
    </div>

    <div class="lab-notes">
        <div class="panel surface">
            <h2>How to read it</h2>
            <ul class="bullets">
                <li>Each block is one matrix of numbers, and each cell on its top face is one number: brighter means larger, and the two colours are positive and negative.</li>
                <li>Blocks with sides in the second colour are weights, the part that is learned. The others are results computed for this example.</li>
                <li>The view steps down the model: embeddings, then for each layer the attention weights, who looks at whom, and the feed-forward step, ending with the letter predicted at every position.</li>
                <li>The numbers below the diagram follow the training run. It takes two minutes, holds on the trained model, and starts again.</li>
            </ul>
        </div>
        <div class="panel surface">
            <h2>How it was made</h2>
            <ul class="bullets">
                <li>The model follows nanoGPT: token and position embeddings, 2 layers, 2 attention heads, a 16-wide stream and a 64-wide feed-forward layer. 6,416 weights in total.</li>
                <li>It was trained once, offline, with backpropagation and Adam written by hand and checked against a numerical gradient. Its weights were saved at 32 points of the run.</li>
                <li>Nothing is trained in your browser. The page blends between the saved snapshots and recomputes the forward pass for every frame.</li>
                <li>
                    Source:
                    <a href="https://github.com/CatalinButacu/CV-Builder/blob/machine-learning-engineer/site/wwwroot/js/nanogpt.js" target="_blank" rel="noopener">the model</a>,
                    <a href="https://github.com/CatalinButacu/CV-Builder/blob/machine-learning-engineer/site/tools/train-nanogpt.js" target="_blank" rel="noopener">the training script</a>.
                    The idea of drawing a GPT as blocks comes from
                    <a href="https://bbycroft.net/llm" target="_blank" rel="noopener">bbycroft.net/llm</a>.
                </li>
            </ul>
        </div>
    </div>
</Section>

@code {
    private ElementReference canvas;
    private ElementReference panel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("NanoGptView.mount", canvas, panel);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("NanoGptView.unmount");
        }
        catch (JSDisconnectedException)
        {
            // The page is closing; there is nothing left to stop.
        }
    }
}
