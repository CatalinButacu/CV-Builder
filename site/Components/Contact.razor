@* The closing band: one invitation, one main action, and the other ways to reach me beside it. *@
<section id="contact" class="section">
    <div class="container-x">
        <div class="band surface">
            <p class="section-eyebrow">Contact</p>
            <h2>Have a model that needs to <span class="gradient-text">reach production?</span></h2>
            <p class="lede">
                Tell me what you are building. Email is the fastest way to reach me.
            </p>
            <div class="actions">
                <a class="btn primary lg" href="mailto:@Profile.Person.Email" rel="me">@Profile.Person.Email</a>
                <a class="text-link" href="@Profile.Person.LinkedIn" target="_blank" rel="noopener me">LinkedIn</a>
                <a class="text-link" href="@Profile.Person.GitHub" target="_blank" rel="noopener me">GitHub</a>
                <a class="text-link" href="cv.pdf" target="_blank" rel="noopener">Download CV</a>
            </div>
        </div>
    </div>
</section>
